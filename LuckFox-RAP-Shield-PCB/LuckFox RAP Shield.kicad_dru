(version 1)

# J1's pads are intentionally centered on the board edge -- they are
# edge-castellated (lap-solder) pads for the LuckFox Pico Mini module,
# not header pins, so half the pad copper (0.9mm, half of the 1.8mm pad
# width) is meant to extend PAST the cut edge, not just touch it -- the
# real clearance there is negative. The default "copper to edge"
# clearance rule doesn't know about castellation and flags every one of
# these pads; -2mm comfortably covers the overhang so DRC reflects the
# real, intentional design instead of a false positive.
(rule "J1 castellated edge pads"
	(condition "A.Reference == 'J1'")
	(constraint edge_clearance (min -2mm))
)

# B2 is a full-size ESP32-S3 DevKitC breakout board footprint (its
# silkscreen outline and per-pin GPIO labels are the board's own
# printed markings, reproduced here for reference) sitting right next
# to J1's castellated edge and this board's own bottom-right corner.
# Several of its pin-label texts and its outline rectangle sit closer
# to Edge.Cuts than the default silk clearance allows -- this is
# pre-existing layout, not something routing changed, and purely
# cosmetic (silkscreen ink, no copper). -2mm silences the false
# positives the same way the J1 rule above does for copper.
(rule "B2 silkscreen near board edge"
	(condition "A.Reference == 'B2'")
	(constraint silk_clearance (min -2mm))
)
