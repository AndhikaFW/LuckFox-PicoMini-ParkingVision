digraph LuckFoxRAPShieldWiring {
    rankdir=LR;
    bgcolor="white";
    splines=polyline;
    concentrate=false;
    nodesep=1.1;
    ranksep=2.0;
    node [shape=record, fontname="Helvetica", fontsize=11, style="rounded,filled", fillcolor="#f7fafc", color="#2d3748"];
    edge [fontname="Helvetica", fontsize=9, color="#4a5568", fontcolor="#2d3748"];

    // ---- external, off-shield items ----
    ADAPTER [label="12V DC Adapter\n(external)", shape=box, style="rounded,filled", fillcolor="#718096", fontcolor="white"];
    EXTBUCK [label="External reverse-polarity\nprotection + buck module\n12V -> 5V (off-shield)", shape=box, style="rounded,filled", fillcolor="#718096", fontcolor="white"];
    CAM [label="SC3336 Camera\n(direct to LuckFox FPC,\nnot on shield)", shape=box, style="rounded,filled", fillcolor="#718096", fontcolor="white"];

    // ---- shield components (record nodes = pin lists) ----
    U1 [label="{{<p1>1 5V|<p2>2 3V3|<p3>3 GND|<p4>4 EN (NC)|<p5>5 GPIO4 MOSI_LF|<p6>6 GPIO5 MISO_LF|<p7>7 GPIO6 SCK_LF|<p8>8 GPIO7 CS_LF}|U1 ESP32-S3-DevKitC-1|{<p9>9 GPIO9 INT_ETH|<p10>10 GPIO10 CS_ETH|<p11>11 GPIO11 MOSI_ETH|<p12>12 GPIO12 SCK_ETH|<p13>13 GPIO13 MISO_ETH|<p14>14 GPIO15 DATA_RDY_IN|<p15>15 GPIO16 SLAVE_RDY_OUT|<p16>16 GND}}", fillcolor="#c6f6d5"];

    J1 [label="{{<p1>1 VBUS|<p2>2 GND|<p3>3 3V3_OUT (NC)|<p4>4 GPIO1_B2_d (NC)|<p5>5 GPIO1_B3_u (NC)|<p6>6 SPI0_CS0|<p7>7 SPI0_CLK|<p8>8 SPI0_MOSI|<p9>9 SPI0_MISO|<p10>10 DATA_RDY|<p11>11 GPIO1_C5_d (NC)}|J1 LuckFox Pico Mini\n2x11 socket, Pi-HAT style\n(real pin numbers)|{<p12>12 GPIO1_D0_d (NC)|<p13>13 GPIO1_D1_d (NC)|<p14>14 GPIO1_D2_d (NC)|<p15>15 GPIO1_D3_d (NC)|<p16>16 GPIO1_C6_d (NC)|<p17>17 GPIO1_C7_d (NC)|<p18>18 SLAVE_RDY|<p19>19 GPIO4_C0_z (NC)|<p20>20 GPIO4_C1_z (NC)|<p21>21 GND|<p22>22 1V8_OUT (NC)}}", fillcolor="#bee3f8"];

    U2 [label="{{<p1>1 VCC_3V3|<p2>2 GND|<p3>3 RST}|U2 W5500 Ethernet\n(DNP except Gateway)|{<p4>4 CS|<p5>5 SCK|<p6>6 MOSI|<p7>7 MISO|<p8>8 INT}}", fillcolor="#fefcbf"];

    J2 [label="{J2 External 5V Input|{<p1>1 5V_IN|<p2>2 GND_IN}}", fillcolor="#fbd38d"];

    // ---- power chain ----
    ADAPTER -> EXTBUCK [label="12V"];
    EXTBUCK -> J2:p1 [label="5V", style=dotted];
    EXTBUCK -> J2:p2 [label="GND", style=dotted];
    J2:p1 -> U1:p1 [label="+5V_RAIL", color="#c05621", fontcolor="#c05621", penwidth=1.5];
    J2:p1 -> J1:p1 [label="+5V_RAIL\n(VBUS)", color="#c05621", fontcolor="#c05621", penwidth=1.5];
    J2:p2 -> U1:p3 [label="GND", style=dashed];
    J2:p2 -> U2:p2 [label="GND", style=dashed];
    J2:p2 -> J1:p2 [label="GND", style=dashed];
    J2:p2 -> J1:p21 [label="GND", style=dashed];
    U1:p2 -> U2:p1 [label="+3V3_RAIL", color="#276749", fontcolor="#276749", penwidth=1.5];
    U1:p2 -> U2:p3 [label="+3V3_RAIL\n(RST tied high)", color="#276749", fontcolor="#276749", penwidth=1.5, style=dashed];

    // ---- LuckFox SPI0 link (LuckFox = master, ESP32-S3 = slave) ----
    J1:p8 -> U1:p5 [label="MOSI"];
    U1:p6 -> J1:p9 [label="MISO", dir=back];
    J1:p7 -> U1:p7 [label="CLK"];
    J1:p6 -> U1:p8 [label="CS"];
    J1:p10 -> U1:p14 [label="DATA_RDY"];
    U1:p15 -> J1:p18 [label="SLAVE_RDY\n(optional)"];
    CAM -> J1 [label="FPC (direct to\nLuckFox, not shield)", style=dotted, dir=none, color="#718096"];

    // ---- ESP32-S3 <-> W5500 (SPI) ----
    U1:p10 -> U2:p4 [label="CS"];
    U1:p12 -> U2:p5 [label="SCK"];
    U1:p11 -> U2:p6 [label="MOSI"];
    U2:p7 -> U1:p13 [label="MISO"];
    U2:p8 -> U1:p9 [label="INT"];

    labelloc="t";
    label="LuckFox RAP Shield -- Wiring Diagram (solid = signal, dashed = GND/power, dotted = external link, NC = broken out but not wired)";
    fontsize=14;
    fontname="Helvetica";
}
